{
  "asset_201:0008A0": "희미하게 독 냄새가 나...",
  "asset_201:0008C4": "\n이 물에 들어가면 위험하겠어!",
  "asset_203:001590": "이미 숨을 거두었다...",
  "asset_203:0015B0": "\n근처 마을 사람일까?",
  "asset_204:000DD0": " 계약..., 서...라는 글자만\n 겨우 읽을 수 있다.",
  "asset_204:000E04": "남자의 목소리:\n 잠시 여쭤보겠습니다만,",
  "asset_204:000E26": " 이 근처에서 짐을\n 보지 못하셨습니까?",
  "asset_204:000E5C": " 어라,",
  "asset_204:000E66": "그것은!?",
  "asset_204:000E72": " 아, 고맙습니다!!",
  "asset_204:000E8C": " 그건 제 소중한 장사 도구입니다.",
  "asset_204:000EB0": " 소개가 늦었군요.",
  "asset_204:000EC4": " 제 이름은 레논입니다.",
  "asset_204:000EDA": " 흔히들 말하는 악마지요.",
  "asset_204:000F02": "레논:\n 잠깐, 기다려 주십시오!",
  "asset_204:000F2A": " 저는 당신의 적이 아닙니다.",
  "asset_204:000F4E": " 악마성을 찾은 모험가분들께\n 훌륭한 물건을 파는 것이\n 제 일입니다.",
  "asset_204:000FA4": " 악마가 돈을 받고 장사라니\n 우습겠지만, 지옥에서도\n 돈만 있으면 통한다지 않습니까.",
  "asset_204:001002": " 그렇지!",
  "asset_204:00100E": " 여기서 당신을 만난 것도\n 무슨 인연이겠지요.",
  "asset_204:00103C": " 필요하실 때 그 계약서를 써서\n 저를 불러 주십시오.",
  "asset_204:00107A": " 웬만한 곳이라면\n 찾아가겠습니다.",
  "asset_204:0010AC": "레논:\n 이런,",
  "asset_204:0010C4": "벌써 시간이 이렇게 됐군요.",
  "asset_204:0010D8": " 이야기가 너무 길었나 봅니다.",
  "asset_204:0010F6": " 마음이 내키시면\n 언제든 불러 주십시오.",
  "asset_205:001582": "십자가를 든 남자:\n 움직이지 마!",
  "asset_205:00159E": " 움직이지 말라고!",
  "asset_205:0015B8": " 좋아!",
  "asset_205:0015C6": " 자네는 틀림없는 인간 같군.",
  "asset_205:0015E8": " 나는 찰리 빈센트다.",
  "asset_205:001608": " 최강의 뱀파이어 헌터지.",
  "asset_205:00162C": "빈센트:\n 마을 사람 같은데,\n 숲에서 길이라도 잃었나?",
  "asset_205:00167C": "라인하르트:\n 나는 라인하르트 슈나이더다.",
  "asset_205:0016B0": " 드라큘라 백작을 봉인하려고\n 이곳에 왔다.",
  "asset_205:0016E8": "캐리:\n 다들 어린애 취급이야...",
  "asset_205:001710": " 난 드라큘라 백작을\n 봉인하러 왔어!",
  "asset_205:001750": "빈센트:\n 무슨 무모한 소리인가!",
  "asset_205:00177A": " 드라큘라 퇴치는\n 이 몸에게 맡기게!",
  "asset_205:0017AC": " 자네 같은 풋내기가\n 상대할 수 있는 적이 아니야!",
  "asset_205:0017E6": "라인하르트:\n 당신이야말로 흡혈귀를\n 얕보다가는 위험해!",
  "asset_205:00182A": " 지금이라도 안전한 곳으로...",
  "asset_205:001852": "캐리:\n 쓸데없는 참견이야!",
  "asset_205:001874": " 당신하고는 상관없는 일이니\n 끼어들지 마!",
  "asset_205:0018B2": "빈센트:\n 고집 센 녀석이군.",
  "asset_205:0018D4": " 잘 들어.\n 딱 한 번만 더 충고하지.",
  "asset_205:001902": " 당장 이 성에서 떠나!",
  "asset_205:001924": " 알겠나?",
  "asset_206:001B52": "마을 사람:\n 사,",
  "asset_206:001B62": "사,",
  "asset_206:001B68": "살려 줘!\n",
  "asset_206:001B7C": " 이 근처는 괴물투성이야.",
  "asset_206:001B9C": " 소문대로 악마가 사는 성이야!",
  "asset_206:001BC6": "라인하르트:\n 왜 그러지?",
  "asset_206:001BE4": " 대체 무슨 일이 있었나?",
  "asset_206:001C04": "캐리:\n 왜 그래?",
  "asset_206:001C20": " 대체 무슨 일이 있었어?",
  "asset_206:001C42": "마을 사람:\n 나, 나쁜 뜻으로 하는 말이 아냐!",
  "asset_206:001C66": "\n 목숨이 아까우면 당신도 어서",
  "asset_206:001C88": "\n 여기서 달아나는 게...",
  "asset_206:001CF2": "흡혈귀:\n 크크크크크크크크크크크크.",
  "asset_206:001D1E": " 네놈은 다른 모험가들과는\n 조금 다른 것 같군...",
  "asset_206:001D52": " 어떤 피 맛이 나는지\n 확인해 주마!",
  "asset_207:00149C": "라인하르트:\n 누구냐!\n",
  "asset_207:0014C0": "캐리:\n 누구야!\n",
  "asset_207:0014E2": "남자아이:\n 제발,",
  "asset_207:0014F8": " 살려 줘...",
  "asset_207:001510": "라인하르트:\n 어린아이가\n 왜 이런 곳에...?",
  "asset_207:00154C": " 내 이름은 라인하르트다.",
  "asset_207:001566": " 안심해. 난 네 편이야.",
  "asset_207:001586": "캐리:\n 어린아이가\n 왜 이런 곳에...?",
  "asset_207:0015C2": " 나는 캐리야.",
  "asset_207:0015D6": " 걱정 마.\n 이제 울지 않아도 돼.",
  "asset_207:00160A": "남자아이:\n 나는,",
  "asset_207:001620": "말루스...\n",
  "asset_207:001638": "라인하르트:\n 그래, 말루스.",
  "asset_207:00165A": " 왜 이렇게 위험한 곳에\n 혼자 있는 거지?",
  "asset_207:001692": "캐리:\n 말루스구나.",
  "asset_207:0016AC": " 왜 이런 위험한 곳에\n 혼자 있었어?",
  "asset_207:0016E6": "말루스:\n 마물들이 마을에 불을 질렀어...",
  "asset_207:001712": " 우리 집도...",
  "asset_207:001728": " 분명 아빠와 엄마는\n 이미...",
  "asset_207:00175E": "라인하르트:\n 이런 끔찍한 일이...\n",
  "asset_207:001790": "캐리:\n 이럴 수가...\n",
  "asset_207:0017BA": "말루스:\n 친구들도 많이 악마성에\n 끌려왔어.",
  "asset_207:0017F6": " 성에서는 검은 망토를 입은 마인이\n 아이들 중에서 누군가를\n 찾고 있었던 것 같아...",
  "asset_207:00184C": " 그러고는,",
  "asset_207:00185A": "그러고는...",
  "asset_207:00186C": " 으윽, 머리가,",
  "asset_207:00187E": "머리가 아파.",
  "asset_207:00188E": " 생각이 안 나...",
  "asset_207:0018AC": "라인하르트:\n 괘,",
  "asset_207:0018C4": "괜찮니?",
  "asset_207:0018D0": " 이제 됐다. 말하지 않아도 돼.",
  "asset_207:0018F8": "캐리:\n 괘,",
  "asset_207:00190C": "괜찮아?",
  "asset_207:001916": " 지친 거야. 이제 됐어.",
  "asset_207:001940": "말루스:\n 으아아아아아아아아아악!!\n",
  "asset_207:001978": "라인하르트:\n 기다려, 말루스!",
  "asset_207:00199E": " 내 곁에서 떨어지지 마!",
  "asset_207:0019C0": "캐리:\n 진정해!",
  "asset_207:0019DE": " 혼자 달아나면 위험해!",
  "asset_208:0010D4": "라인하르트:\n 여기까지 왔으면 괜찮다.",
  "asset_208:001100": " 저 앞의 숲만 빠져나가면\n 탈출할 수 있어.",
  "asset_208:00112A": " 사내아이잖니. 할 수 있지?\n",
  "asset_208:00114E": "캐리:\n 여기까지 왔으면...",
  "asset_208:001172": " 저 앞의 숲만 빠져나가면\n 마을까지 달아날 수 있을 거야.",
  "asset_208:0011AE": " 숲에 있는 마물들을 조심해.\n"
}
